{
  "manifest_version": 3,
  "name": "Parsian Pro Trader",
  "version": "2.0.23",
  "author": "mohammad mohammadi",
  "host_permissions": [
    "https://patris.parsianbroker.com/*",
    "https://red.parsianbroker.com/*",
    "https://khobregan.tsetab.ir/*",
    "https://khobregan-red.tsetab.ir/*",
    "https://gs.ephoenix.ir/*",
    "https://api-gs.ephoenix.ir/*",
    "https://gs-mdp.ephoenix.ir/*",
    "https://marketdatagw.ephoenix.ir/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://patris.parsianbroker.com/*",
        "https://khobregan.tsetab.ir/*",
        "https://khobregan-red.tsetab.ir/*",
        "https://gs.ephoenix.ir/*"
      ],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["config.js", "broker-adapters.js", "ui.html", "ui.css", "ui.js"],
      "matches": [
        "https://patris.parsianbroker.com/*",
        "https://khobregan.tsetab.ir/*",
        "https://khobregan-red.tsetab.ir/*",
        "https://gs.ephoenix.ir/*"
      ]
    }
  ]
}
